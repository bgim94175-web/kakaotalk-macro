<?xml version="1.0" encoding="utf-8"?>
<!-- 사용자앱과 같은 밝은 업무용 테마. -->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF2F4F6</item>
        <item name="android:colorBackground">#FFF2F4F6</item>
        <item name="android:statusBarColor">#FFF2F4F6</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorPrimary">#FF3182F6</item>
        <item name="android:colorPrimaryDark">#FF1B64DA</item>
        <item name="android:colorAccent">#FF3182F6</item>
        <item name="android:textColorPrimary">#FF191F28</item>
        <item name="android:textColorSecondary">#FF4E5968</item>
        <item name="android:textColorHint">#FF8B95A1</item>
        <item name="android:textColorHighlight">#663182F6</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="AppDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:colorBackground">#FFFFFFFF</item>
        <item name="android:colorAccent">#FF3182F6</item>
        <item name="android:textColorPrimary">#FF191F28</item>
        <item name="android:textColorSecondary">#FF4E5968</item>
    </style>
</resources>
