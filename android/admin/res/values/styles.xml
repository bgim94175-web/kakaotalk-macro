<?xml version="1.0" encoding="utf-8"?>
<!-- 사용자앱과 같은 다크 토큰. 강조색만 바이올렛. -->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0A0B0F</item>
        <item name="android:colorBackground">#FF0A0B0F</item>
        <item name="android:statusBarColor">#FF0A0B0F</item>
        <item name="android:navigationBarColor">#FF0A0B0F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorPrimary">#FF0A0B0F</item>
        <item name="android:colorPrimaryDark">#FF0A0B0F</item>
        <item name="android:colorAccent">#FFD4B27A</item>
        <item name="android:textColorPrimary">#FFF2EEE6</item>
        <item name="android:textColorSecondary">#FFA39E95</item>
        <item name="android:textColorHint">#FF6B675F</item>
        <item name="android:textColorHighlight">#66D4B27A</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- 다이얼로그용 (Ui.dialog 이 이 스타일로 AlertDialog 를 만든다) -->
    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">#FF1C1F27</item>
        <item name="android:colorBackground">#FF1C1F27</item>
        <item name="android:colorAccent">#FFD4B27A</item>
        <item name="android:textColorPrimary">#FFF2EEE6</item>
        <item name="android:textColorSecondary">#FFA39E95</item>
    </style>
</resources>
