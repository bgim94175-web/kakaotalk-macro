<?xml version="1.0" encoding="utf-8"?>
<!-- 카톡 오토 (사용자앱) · 라이브러리 의존성 0 · AndroidX 없음 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.buseong.kakaoauto"
    android:versionCode="32"
    android:versionName="2.1.11">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- 라이선스 검증 · 하트비트 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 부팅 후 주기 발송 복구 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 정확한 시각 발송 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 도즈 모드에서 안 끊기게 배터리 최적화 제외 요청 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 화면 꺼진 동안 한 주기 발송이 중간에 안 끊기게 (Scheduler 의 PARTIAL_WAKE_LOCK) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 상태 알림 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 첨부 이미지 읽기 (33+ 는 READ_MEDIA_IMAGES, 32 이하는 READ_EXTERNAL_STORAGE) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 카카오 연결 유지 서비스 (engine/EngineService). 34+ 는 타입별 권한이 따로 필요하다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 알림 읽기 권한 설정 화면으로 보내기 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 다른 앱 위에 표시. 사진 전송에 꼭 필요하다 —
         안드로이드 10+ 는 앱이 화면에 없을 때 startActivity 를 조용히 막는데(백그라운드 액티비티 차단),
         이 권한이 있으면 예외로 허용된다. 매크로는 백그라운드에서 도니까 이게 없으면
         카톡 공유창이 아예 안 뜬다. 오버레이 창을 띄우는 용도로는 쓰지 않는다. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- QUERY_ALL_PACKAGES 안 쓴다. 카톡만 조회한다. -->
    <queries>
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true">
        <!-- extractNativeLibs=true 여야 한다: 카카오 엔진 실행파일(lib/<abi>/libkmnode.so)은
             설치 때 nativeLibraryDir 로 풀려야 exec 할 수 있다 (안드로이드 10+ 는 그 밖에서 exec 금지). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 화면 깨우기 전용 투명 액티비티.
             화면이 꺼져 있거나 잠겨 있으면 카톡 공유창이 못 뜬다. 이 앱은 매크로 전용 폰에서
             도니까 깨워도 된다 — 켜고 잠금 해제를 요청한 다음 공유 인텐트를 실행하고 바로 사라진다.
             theme 은 투명(배경이 안 보인다), noHistory 로 백스택에 안 남고,
             excludeFromRecents 로 최근 앱 목록에도 안 뜬다.
             exported=false : 우리 앱만 부른다 (인텐트를 실어 주는 통로라 절대 열어두면 안 된다). -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <!-- 카톡 알림 파싱 + RemoteInput 발송 -->
        <service
            android:name=".KakaoListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 카톡 공유 UI 자동 조작 (이미지 전송) -->
        <service
            android:name=".KakaoAccessibility"
            android:exported="true"
            android:label="@string/acc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <!-- 카카오 계정 연결 유지 (포그라운드 서비스). 매크로가 켜져 있고 카카오 계정이 연결됐을 때만 돈다.
             exported=false : 우리 앱만 시작/정지한다. -->
        <service
            android:name=".engine.EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's own KakaoTalk session and scheduled message sending alive in the background." />
        </service>

        <!-- 주기 발송 알람 · 라이선스 하트비트 알람 전용.
             알람은 우리 앱이 명시적 PendingIntent 로 부르니까 exported 가 필요 없다.
             intent-filter 도 두지 않는다 — 열어두면 아무 앱이나 발송을 강제로 트리거할 수 있다. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false"
            android:directBootAware="false" />

        <!-- 부팅·앱 업데이트 복구 전용.
             부팅 브로드캐스트는 시스템(다른 UID)이 보내니까 exported="true" 여야 들어온다.
             BOOT_COMPLETED · MY_PACKAGE_REPLACED 는 시스템 전용 보호 브로드캐스트라 서드파티가 못 보내고,
             QUICKBOOT_POWERON 은 보호되지 않지만 이 리시버가 하는 일은 알람 재예약뿐이라 악용 여지가 없다. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
